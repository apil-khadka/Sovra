# Committed shape of the local-only .env (which is gitignored).
# Copy to .env and fill secrets there; never commit filled values.
#
#   cp .env.example .env
#
# Live planning (SOV-013, OD-02): OpenAI-compatible chat endpoint.
# Default boot stays keyless and fixture-only; live calls happen
# only when SOVRA_AI_LIVE_ENABLED=true with a full triple.
# Current OD-02 candidate: Baseten hackathon grant for Meta Global
# AI Developer Hackathon ($100 credits, model below only).
SOVRA_AI_LIVE_ENABLED=false
SOVRA_AI_BASE_URL=https://inference.baseten.co/v1
SOVRA_AI_MODEL=meta-models/muse-spark-open-1026
# One-time Baseten key. The hackathon key works ONLY with the model
# above; keep it in .env, never in the repo or chat logs.
SOVRA_AI_API_KEY=

# Fleet live-AI budgets (PROD-012, see docs/engineering/ai-budgets.md).
# All zero/disabled by default: live spending needs
# SOVRA_AI_LIVE_ENABLED=true AND funded limits AND the model on the
# SOVRA_AI_ALLOWED_MODELS allowlist. A bounded manual session funds a
# small pre-declared call/token budget, then returns these to zero and
# disarms. Lease must cover one provider timeout plus 30s margin.
SOVRA_AI_BUDGET_DAILY_REQUESTS=0
SOVRA_AI_BUDGET_DAILY_TOKENS=0
SOVRA_AI_BUDGET_MAX_CONCURRENCY=0
SOVRA_AI_BUDGET_LEASE_SECONDS=120
# Metered calls require SDK retries off (default) and refuse to run
# with any other value; plan-level retry stays an honest re-reserved
# 503. Model allowlist: empty denies every live call; listing a model
# id is an operator control, not qualification evidence (see docs).
# Never auto-allow: keep empty until the model is qualified.
SOVRA_AI_MAX_RETRIES=0
SOVRA_AI_ALLOWED_MODELS=
# Per-attempt wire cap: the guard refuses transcripts past this many
# JSON-escaped bytes before any provider contact. Remaining
# bound/timeout/tool/output knobs (PlanningProperties defaults):
SOVRA_AI_MAX_TRANSCRIPT_BYTES=32768
SOVRA_AI_MAX_TOOL_CALLS=8
SOVRA_AI_TIMEOUT=10s
SOVRA_AI_MAX_TOKENS=8000
SOVRA_AI_MAX_PROMPT_CHARS=8000
SOVRA_AI_TEMPERATURE=0.0
SOVRA_AI_SEED=7

# Public-demo admission (SOV-027): true rejects caller-supplied
# vault/quarantine bytes (403 demo_synthetic_only). Local default
# false so synthetic API tests can seal; the public-demo compose
# profile forces true on both app instances.
SOVRA_DEMO_SYNTHETIC_ONLY=false
