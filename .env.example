# Committed shape of the local-only .env (which is gitignored).
# Copy to .env and fill secrets there; never commit filled values.
#
#   cp .env.example .env
#
# Live planning (SOV-013, OD-02): OpenAI-compatible chat endpoint.
# Default boot stays keyless and fixture-only; live calls happen
# only when SOVRA_AI_LIVE_ENABLED=true with a full triple.
# Current OD-02 candidate: Baseten hackathon grant for Meta Global
# AI Developer Hackathon ($100 credits, model below only).
SOVRA_AI_LIVE_ENABLED=false
SOVRA_AI_BASE_URL=https://inference.baseten.co/v1
SOVRA_AI_MODEL=meta-models/muse-spark-open-1026
# One-time Baseten key. The hackathon key works ONLY with the model
# above; keep it in .env, never in the repo or chat logs.
SOVRA_AI_API_KEY=
